{
  "name": "buzz-plugins-public",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "description": "Index of publicly fetchable Buzz plugins, crawled from sources.txt and published as a static index.json",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"indexer/*.test.ts\"",
    "crawl": "node --experimental-strip-types indexer/crawl.ts --sources sources.txt --previous .data/index.json --out .data/index.json --report .data/crawl-report.json",
    "check-sources": "node --experimental-strip-types indexer/check-sources.ts",
    "check-plugin": "node --experimental-strip-types indexer/check-plugin.ts",
    "add": "node --experimental-strip-types indexer/add.ts",
    "validate": "node --experimental-strip-types indexer/validate.ts"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  }
}
